# Neon Postgres connection string (Vercel Marketplace -> Neon, or neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=

# Discord application -> OAuth2 (https://discord.com/developers/applications)
# Redirect URL to register: https://<your-domain>/api/auth/callback/discord
# For local dev also add: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Comma-separated Discord user IDs that can always edit (bootstrap admins).
# Editors added from the admin page are stored in the database instead.
ADMIN_DISCORD_IDS=

# Channel webhook used by the Handlers page's "Post to Discord" button
# (Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=

# LFM Structure has no webhook env var: each document (Team Structure,
# Authority & Sign-Off Levels, ...) has its own webhook URL field, set from
# its panel on /admin/structure, since each can post to a different channel.
